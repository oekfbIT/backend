# Stripe configuration template. Other existing backend settings are still required.
# Stripe top-ups: sandbox (test money) or production (real money).
# Fill the credentials for each environment; never commit real keys.
STRIPE_MODE=sandbox

# Stripe sandbox: sk_test_..., pk_test_..., whsec_...
STRIPE_SANDBOX_SECRET_KEY=
STRIPE_SANDBOX_PUBLISHABLE_KEY=
STRIPE_SANDBOX_WEBHOOK_SECRET=

# Stripe production: sk_live_..., pk_live_..., whsec_...
STRIPE_PRODUCTION_SECRET_KEY=
STRIPE_PRODUCTION_PUBLISHABLE_KEY=
STRIPE_PRODUCTION_WEBHOOK_SECRET=

# App/site HTTPS return pages; localhost HTTP is allowed in sandbox.
STRIPE_CHECKOUT_SUCCESS_URL=
STRIPE_CHECKOUT_CANCEL_URL=
STRIPE_TOPUP_MAX_MINOR=500000
