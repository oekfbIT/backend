# Stripe configuration template. Other existing backend settings are still required.
# Stripe top-ups: sandbox (test money) or production (real money).
# Fill the credentials for each environment; never commit real keys.
STRIPE_MODE=sandbox

# Stripe sandbox: sk_test_..., pk_test_..., whsec_...
STRIPE_SANDBOX_SECRET_KEY=
STRIPE_SANDBOX_PUBLISHABLE_KEY=
STRIPE_SANDBOX_WEBHOOK_SECRET=

# Stripe production: sk_live_..., pk_live_..., whsec_...
STRIPE_PRODUCTION_SECRET_KEY=
STRIPE_PRODUCTION_PUBLISHABLE_KEY=
STRIPE_PRODUCTION_WEBHOOK_SECRET=

# App/site HTTPS return pages; localhost HTTP is allowed in sandbox.
STRIPE_CHECKOUT_SUCCESS_URL=
STRIPE_CHECKOUT_CANCEL_URL=
STRIPE_TOPUP_MAX_MINOR=500000

# SMTP credentials are required for transactional email. Never place these in
# Swift source or commit real values.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=

# Public HTTPS URL of the blank registration contract linked from welcome mail.
REGISTRATION_CONTRACT_URL=https://www.example.com/registration-contract.pdf

# Server-side Firebase account used by authenticated upload endpoints.
FIREBASE_APIKEY=
FIREBASE_EMAIL=
FIREBASE_PASSWORD=
FIREBASE_PROJECTID=

# Base URL used in registration emails; use http://localhost:1234 for local development.
REGISTRATION_WEB_BASE_URL=https://www.oekfb.eu
# Optional mailbox for new requests and document submissions.
REGISTRATION_ADMIN_EMAIL=office@oekfb.eu

# AI commentator: disabled until an API key and model are configured.
OPENAI_API_KEY=
COMMENTATOR_ENABLED=false
COMMENTATOR_AI_PROVIDER=openai
COMMENTATOR_AI_MODEL=
COMMENTATOR_AI_BASE_URL=https://api.openai.com/v1
COMMENTATOR_SERVICE_KEY=
# Set true for the trusted automation caller: generation publishes by default.
# Leave false for a credential limited to context reads and publish:false tests.
COMMENTATOR_ALLOW_SERVICE_PUBLISH=false
COMMENTATOR_ALLOW_PARTIAL_PUBLISH=false
COMMENTATOR_CONCURRENCY=3
COMMENTATOR_TIMEOUT_SECONDS=60
COMMENTATOR_MAX_OUTPUT_TOKENS=1800
COMMENTATOR_MAX_ATTEMPTS=3
COMMENTATOR_BATCH_LIMIT=150
COMMENTATOR_MAX_PREVIEW_WORDS=150
COMMENTATOR_MAX_SUMMARY_WORDS=900
COMMENTATOR_POLL_SECONDS=5
COMMENTATOR_TEMPERATURE=
COMMENTATOR_AI_API_KEY=
